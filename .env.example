# =============================================================================
# Coin Marketplace - Environment Variables Example
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/coin_marketplace
DB_USERNAME=coinuser
DB_PASSWORD=coinpass123

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- RabbitMQ ---
MQ_HOST=localhost
MQ_PORT=5672
MQ_USERNAME=coinmq
MQ_PASSWORD=coinmq123

# --- Elasticsearch ---
ES_URIS=http://localhost:9200

# --- JWT ---
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# --- Storage (S3/MinIO) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=coinmarket

# --- File Upload ---
UPLOAD_DIR=./uploads

# --- Rating APIs ---
NGC_API_KEY=
PCGS_API_KEY=
PMG_API_KEY=

# --- Stripe ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
